; Bastion Front - Godot 4.7 movement sandbox.
config_version=5

[application]
config/name="Bastion Front"
run/main_scene="res://scenes/missions/forest_command_post.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
PrototypeSession="*res://scripts/systems/prototype_session.gd"
CombatAudio="*res://scripts/systems/combat_audio.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[input]
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
grenade={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":71)]
}
slot_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
slot_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
slot_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
slot_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}
allied_loadout={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194332)]
}
german_loadout={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194333)]
}
next_weapon={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5)]
}
previous_weapon={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4)]
}
restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194309)]
}
fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
aim={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_backward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
crouch={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
release_mouse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
capture_mouse={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Infantry"
3d_physics/layer_4="Projectiles"
3d_physics/layer_5="Interaction"

[physics]
3d/default_gravity=9.8

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver.windows="vulkan"
environment/defaults/default_clear_color=Color(0.28, 0.31, 0.32, 1)
